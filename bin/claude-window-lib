#!/usr/bin/env bash
# Shared helpers for claude-window-* hooks

# Returns the state directory (persistent storage for all session state + logs).
cw_state_dir() {
  printf '%s' "${CLAUDE_TMUX_STATE_DIR:-${HOME}/.local/state/claude-tmux}"
}

# Resolve window + read state in one call. Exits if window resolution fails.
# Sets WINDOW_ID, BASE, total, completed, deleted, label, active.
cw_init() {
  cw_resolve_window || exit 0
  cw_read_state
}

# Sets WINDOW_ID and BASE. Returns 1 on failure (caller should exit).
# BASE is keyed by session+window ID to prevent state bleed across server restarts.
cw_resolve_window() {
  [ -z "${TMUX:-}" ] && return 1
  local pane="${TMUX_PANE:-}" wid sid
  if [ -n "$pane" ]; then
    wid=$(tmux display-message -t "$pane" -p '#{window_id}' 2>/dev/null) || return 1
    sid=$(tmux display-message -t "$pane" -p '#{session_id}' 2>/dev/null) || return 1
  else
    wid=$(tmux display-message -p '#{window_id}' 2>/dev/null) || return 1
    sid=$(tmux display-message -p '#{session_id}' 2>/dev/null) || return 1
  fi
  # shellcheck disable=SC2034
  WINDOW_ID="$wid"
  local state_dir
  state_dir="$(cw_state_dir)"
  mkdir -p "$state_dir"
  # shellcheck disable=SC2034
  BASE="${state_dir}/claude-window-s${sid//[^0-9]/}_w${wid//[^0-9]/}"
}

# Reads counter state into global vars. Requires BASE to be set.
# `active` is clamped at 0: stale on-disk state where `deleted` exceeds `total`
# (e.g. TaskUpdate(deleted) firing before TaskCreate at session start) would
# otherwise produce a negative count in the window title.
cw_read_state() {
  total=$(cat "${BASE}.total" 2>/dev/null || echo 0)
  completed=$(cat "${BASE}.completed" 2>/dev/null || echo 0)
  deleted=$(cat "${BASE}.deleted" 2>/dev/null || echo 0)
  label=$(cat "${BASE}.label" 2>/dev/null || echo "")
  if [ "$total" -gt "$deleted" ]; then
    active=$((total - deleted))
  else
    active=0
  fi
}

# Prints the correct progress title based on current state.
# Requires cw_read_state and BASE to be set. Callers must ensure total > 0.
cw_title() {
  if [ "$active" -gt 0 ] && [ "$completed" -ge "$active" ]; then
    printf '✓ %s/%s%s' "$active" "$active" "${label:+ $label}"
  else
    printf '▶ %s/%s%s' "$completed" "$active" "${label:+ $label}"
  fi
}

# Records the last stable title so the broad restore hook can skip tmux
# window-name reads when no transient indicator needs clearing.
cw_cache_title() {
  printf '%s' "$1" > "${BASE}.title" 2>/dev/null || true
  rm -f "${BASE}.transient" 2>/dev/null || true
}

# Stable title updates are the normal desired state for the window.
cw_rename_desired() {
  local title="$1"
  cw_cache_title "$title"
  tmux rename-window -t "$WINDOW_ID" "$title" 2>/dev/null || true
}

# Transient title updates are cleared by claude-window-restore after the next
# tool completes.
cw_rename_transient() {
  local title="$1"
  : > "${BASE}.transient" 2>/dev/null || true
  tmux rename-window -t "$WINDOW_ID" "$title" 2>/dev/null || true
}

# Restores the stable title, avoiding the expensive tmux current-title lookup
# when our cache already says the window is in the desired stable state.
cw_restore_desired() {
  local desired="$1" cached=""
  cached=$(cat "${BASE}.title" 2>/dev/null || echo "")
  if [ ! -f "${BASE}.transient" ] && [ "$cached" = "$desired" ]; then
    return 0
  fi

  local current
  current=$(tmux display-message -t "$WINDOW_ID" -p '#{window_name}' 2>/dev/null || echo "")
  if [ "$current" != "$desired" ]; then
    tmux rename-window -t "$WINDOW_ID" "$desired" 2>/dev/null || true
  fi
  cw_cache_title "$desired"
}

# Returns the stored workspace name, falling back to $PWD basename.
cw_workspace() {
  basename "$(cat "${BASE}.cwd" 2>/dev/null || echo "$PWD")"
}

# Strips control characters (ESC, BEL, CR, LF, TAB, etc.) from a string so it
# cannot corrupt a tmux window title, the TSV activity log, or a terminal
# escape sequence. tmux >= 3.2 does single-pass format expansion, so a literal
# `#(...)` in a name is NOT re-expanded or executed; this is display-integrity
# hygiene (and TSV/escape safety), not a command-injection fix. Prints cleaned.
cw_sanitize() {
  printf '%s' "$1" | tr -d '[:cntrl:]'
}

# Emits a best-effort desktop notification. macOS: osascript, with text passed
# via env vars so user-controlled labels cannot inject AppleScript literals.
# Elsewhere (Linux, *BSD, and notably SSH-remote sessions where D-Bus is
# unreachable): an OSC 777 "notify" escape written to the pane TTY, wrapped in
# tmux passthrough so it reaches the outer terminal emulator. The escape rides
# the terminal stream, so it works over SSH where notify-send / D-Bus do not.
# Args: <title> <body>. Never fails the caller; requires TMUX_PANE for the OSC
# path.
#
# Caveats: OSC 777/9 support is fragmented across terminals and is silently
# ignored where unimplemented. Inside tmux the outer terminal must allow
# passthrough (`set -g allow-passthrough on`) for the escape to surface.
cw_notify() {
  local title body
  title="$(cw_sanitize "$1")"
  body="$(cw_sanitize "$2")"

  if command -v osascript >/dev/null 2>&1; then
    CLAUDE_TMUX_TITLE="$title" CLAUDE_TMUX_BODY="$body" \
      osascript <<'APPLESCRIPT' 2>/dev/null || true
on run
  set theBody to system attribute "CLAUDE_TMUX_BODY"
  set theTitle to system attribute "CLAUDE_TMUX_TITLE"
  display notification theBody with title theTitle
end run
APPLESCRIPT
    return 0
  fi

  [ -z "${TMUX_PANE:-}" ] && return 0
  local tty
  tty=$(tmux display-message -t "$TMUX_PANE" -p '#{pane_tty}' 2>/dev/null) || return 0
  [ -z "$tty" ] && return 0

  # OSC 777: ESC ] 777 ; notify ; <title> ; <body> BEL
  local osc
  osc=$(printf '\033]777;notify;%s;%s\007' "$title" "$body")
  if [ -n "${TMUX:-}" ]; then
    # tmux passthrough: DCS `tmux;` <payload, each ESC doubled> ST (ESC backslash).
    printf "%b%s%b\\\\" '\033Ptmux;' "${osc//$'\033'/$'\033\033'}" '\033' > "$tty" 2>/dev/null || true
  else
    printf '%s' "$osc" > "$tty" 2>/dev/null || true
  fi
}

# Opens fd 9 on a per-BASE lockfile and (if `flock` is present) acquires an
# exclusive advisory lock. Call `cw_unlock` to release.
#
# Hook scripts fire in parallel when Claude invokes tools concurrently
# (e.g. two subagents emitting TaskUpdate at the same time). Without a lock,
# the read-modify-write on `.total` / `.completed` / `.deleted` can lose
# increments. `flock` is absent on stock macOS; there we fall back to a
# `mkdir`-based advisory lock with a 5-second bound.
cw_lock() {
  local lockfile="${BASE}.lock"
  : > "$lockfile" 2>/dev/null || return 0
  # shellcheck disable=SC1083
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$lockfile"
    flock -x -w 5 9 2>/dev/null || true
  else
    local d="${BASE}.lockd" i=0
    while ! mkdir "$d" 2>/dev/null; do
      i=$((i + 1)); [ "$i" -ge 50 ] && { rmdir "$d" 2>/dev/null || true; break; }
      sleep 0.1
    done
    CW_LOCK_DIR="$d"
  fi
}
cw_unlock() {
  if [ -n "${CW_LOCK_DIR:-}" ]; then
    rmdir "$CW_LOCK_DIR" 2>/dev/null || true
    unset CW_LOCK_DIR
  else
    exec 9>&- 2>/dev/null || true
  fi
}

# Renames tmux window with symbol-prefixed title. Symbol is shown with task progress
# if total > 0, or workspace name if no tasks. Requires WINDOW_ID, total, and cw_workspace.
cw_rename_symbol() {
  local symbol="$1"
  if [ "$total" -gt 0 ]; then
    cw_rename_transient "${symbol} ${completed}/${active}${label:+ $label}"
  else
    cw_rename_transient "${symbol} $(cw_workspace)"
  fi
}

# Clears task state files. Requires BASE to be set.
cw_clear_state() {
  rm -f "${BASE}.total" "${BASE}.completed" "${BASE}.deleted" "${BASE}.label" \
    "${BASE}.title" "${BASE}.transient"
}

# Removes all state for a window key (used for GC of orphaned sessions).
# Argument: state directory + key prefix (e.g. "$state_dir/claude-window-s0_w1")
cw_remove_window_state() {
  local prefix="$1"
  rm -f "${prefix}".{cwd,stopped,total,completed,deleted,label,title,transient,lock}
  rmdir "${prefix}.lockd" 2>/dev/null || true
}

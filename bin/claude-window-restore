#!/usr/bin/env bash
# Claude Code PostToolUse hook — restores correct title after any tool
# Clears transient states like '?' and '!' back to the real progress state

set -euo pipefail
trap 'exit 0' ERR

source "${BASH_SOURCE[0]%/*}/claude-window-lib"
cw_init

if [ "$total" -eq 0 ]; then
  desired="○ $(cw_workspace)"
else
  desired="$(cw_title)"
fi

current=$(tmux display-message -t "$WINDOW_ID" -p '#{window_name}' 2>/dev/null || echo "")

if [ "$current" != "$desired" ]; then
  tmux rename-window -t "$WINDOW_ID" "$desired" 2>/dev/null || true
fi

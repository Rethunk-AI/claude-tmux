#!/bin/bash
# claude-window-aggregate — compact active Claude window count for tmux status-right
# Usage in tmux: set -g status-right '#(~/.local/bin/claude-window-aggregate) ...'
# Output example: "2▶ 1✓ 1■ "

source "${BASH_SOURCE[0]%/*}/claude-window-lib"
state_dir="$(cw_state_dir)"

# Build set of live window keys from tmux to skip orphaned state files
declare -A LIVE
while IFS=' ' read -r sid wid; do
  key="s${sid//[^0-9]/}_w${wid//[^0-9]/}"
  LIVE["$key"]=1
done < <(tmux list-windows -a -F '#{session_id} #{window_id}' 2>/dev/null)

in_progress=0
complete=0
stopped=0

# Count active sessions from .total files
for f in "${state_dir}"/claude-window-*.total; do
  [ -f "$f" ] || continue
  key="${f##*/claude-window-}"
  key="${key%.total}"
  [ -z "${LIVE[$key]+_}" ] && continue  # orphan — window no longer exists
  total=$(cat "$f" 2>/dev/null || echo 0)
  [ "$total" -eq 0 ] && continue
  completed=$(cat "${state_dir}/claude-window-${key}.completed" 2>/dev/null || echo 0)
  deleted=$(cat "${state_dir}/claude-window-${key}.deleted" 2>/dev/null || echo 0)
  active=$((total - deleted))
  [ "$active" -eq 0 ] && continue
  if [ "$completed" -ge "$active" ]; then
    complete=$((complete + 1))
  else
    in_progress=$((in_progress + 1))
  fi
done

# Count stopped sessions: .cwd present, .total absent, window still live
for f in "${state_dir}"/claude-window-*.cwd; do
  [ -f "$f" ] || continue
  key="${f##*/claude-window-}"
  key="${key%.cwd}"
  [ -z "${LIVE[$key]+_}" ] && continue  # orphan
  [ -f "${state_dir}/claude-window-${key}.total" ] && continue  # active, already counted
  [ -f "${state_dir}/claude-window-${key}.stopped" ] && stopped=$((stopped + 1))
done

result=""
[ "$in_progress" -gt 0 ] && result="${result}${in_progress}▶"
[ "$complete" -gt 0 ]    && result="${result}${complete}✓"
[ "$stopped" -gt 0 ]     && result="${result}${stopped}■"
[ -n "$result" ] && printf '%s ' "$result"

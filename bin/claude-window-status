#!/bin/bash
# Claude Code PostToolUse hook — updates tmux window title
# Triggered on TaskCreate / TaskUpdate

set -euo pipefail
trap 'exit 0' ERR

source "${BASH_SOURCE[0]%/*}/claude-window-lib"

HOOK_DATA=$(cat)
TOOL=$(printf '%s' "$HOOK_DATA" | jq -r '.tool_name // ""')

cw_init
cw_lock
trap 'cw_unlock' EXIT

case "$TOOL" in
  TaskCreate)
    total=$((total + 1))
    active=$((total - deleted))
    printf '%s' "$total" > "${BASE}.total"
    if [ -z "$label" ]; then
      if [ -n "${CLAUDE_WINDOW_LABEL:-}" ]; then
        label="$CLAUDE_WINDOW_LABEL"
      else
        label=$(printf '%s' "$HOOK_DATA" \
          | jq -r '.tool_input.subject // ""' \
          | tr '[:upper:]' '[:lower:]' \
          | tr ' ' '-' \
          | cut -c1-24)
      fi
      label="$(cw_sanitize "$label")"
      printf '%s' "$label" > "${BASE}.label"
    fi
    ;;
  TaskUpdate)
    # Drop updates when we never saw the matching TaskCreate — otherwise the
    # `deleted` counter can outrun `total` and push active into negative.
    [ "$total" -eq 0 ] && exit 0
    status=$(printf '%s' "$HOOK_DATA" | jq -r '.tool_input.status // ""')
    case "$status" in
      completed)
        completed=$((completed + 1))
        # Cap at remaining active tasks so completed/active can't exceed 1.0.
        if [ "$completed" -gt "$active" ]; then
          completed="$active"
        fi
        printf '%s' "$completed" > "${BASE}.completed"
        ;;
      deleted)
        deleted=$((deleted + 1))
        # Cap at total so active never goes negative.
        if [ "$deleted" -gt "$total" ]; then
          deleted="$total"
        fi
        active=$((total - deleted))
        printf '%s' "$deleted" > "${BASE}.deleted"
        # `-ge` (not `-eq`) so self-healing still fires if stale state on disk
        # arrived with deleted already > total (pre-clamp versions).
        if [ "$deleted" -ge "$total" ]; then
          cw_clear_state
          tmux rename-window -t "$WINDOW_ID" "○ $(cw_workspace)" 2>/dev/null || true
          exit 0
        fi
        ;;
      *)
        exit 0
        ;;
    esac
    ;;
esac

[ "$total" -eq 0 ] && exit 0
tmux rename-window -t "$WINDOW_ID" "$(cw_title)" 2>/dev/null || true

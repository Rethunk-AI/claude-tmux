#!/usr/bin/env bash
# Claude Code PreToolUse hook — session bootup indicator + CWD tracking
# Fires on every tool call; exits early if tasks are active

set -euo pipefail
trap 'exit 0' ERR

source "${BASH_SOURCE[0]%/*}/claude-window-lib"
cw_init

[ "$total" -gt 0 ] && exit 0

stored_cwd=$(cat "${BASE}.cwd" 2>/dev/null || echo "")
stopped=$(cat "${BASE}.stopped" 2>/dev/null || echo "")

# Show ○ on bootup (no stored CWD), CWD change, or after a Stop
if [ "$stored_cwd" != "$PWD" ] || [ -n "$stopped" ]; then
  printf '%s' "$PWD" > "${BASE}.cwd"
  rm -f "${BASE}.stopped"
  tmux rename-window -t "$WINDOW_ID" "○ $(cw_workspace)" 2>/dev/null || true
fi

#!/bin/bash
# Shared helpers for claude-window-* hooks

# Returns the state directory (persistent storage for all session state + logs).
cw_state_dir() {
  printf '%s' "${CLAUDE_TMUX_STATE_DIR:-${HOME}/.local/state/claude-tmux}"
}

# Sets WINDOW_ID and BASE. Returns 1 on failure (caller should exit).
# BASE is keyed by session+window ID to prevent state bleed across server restarts.
cw_resolve_window() {
  [ -z "${TMUX:-}" ] && return 1
  local pane="${TMUX_PANE:-}" wid sid
  if [ -n "$pane" ]; then
    wid=$(tmux display-message -t "$pane" -p '#{window_id}' 2>/dev/null) || return 1
    sid=$(tmux display-message -t "$pane" -p '#{session_id}' 2>/dev/null) || return 1
  else
    wid=$(tmux display-message -p '#{window_id}' 2>/dev/null) || return 1
    sid=$(tmux display-message -p '#{session_id}' 2>/dev/null) || return 1
  fi
  WINDOW_ID="$wid"
  local state_dir
  state_dir="$(cw_state_dir)"
  mkdir -p "$state_dir"
  BASE="${state_dir}/claude-window-s${sid//[^0-9]/}_w${wid//[^0-9]/}"
}

# Reads counter state into global vars. Requires BASE to be set.
cw_read_state() {
  total=$(cat "${BASE}.total" 2>/dev/null || echo 0)
  completed=$(cat "${BASE}.completed" 2>/dev/null || echo 0)
  deleted=$(cat "${BASE}.deleted" 2>/dev/null || echo 0)
  label=$(cat "${BASE}.label" 2>/dev/null || echo "")
  active=$((total - deleted))
}

# Prints the correct progress title based on current state.
# Requires cw_read_state and BASE to be set. Callers must ensure total > 0.
cw_title() {
  if [ "$active" -gt 0 ] && [ "$completed" -ge "$active" ]; then
    printf '✓ %s/%s%s' "$active" "$active" "${label:+ $label}"
  else
    printf '▶ %s/%s%s' "$completed" "$active" "${label:+ $label}"
  fi
}

# Returns the stored workspace name, falling back to $PWD basename.
cw_workspace() {
  basename "$(cat "${BASE}.cwd" 2>/dev/null || echo "$PWD")"
}

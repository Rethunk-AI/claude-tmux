#!/bin/bash
# Claude Code Stop hook — marks window stopped, clears state for next session

set -euo pipefail
trap 'exit 0' ERR

source "${BASH_SOURCE[0]%/*}/claude-window-lib"
cw_resolve_window || exit 0
cw_lock
trap 'cw_unlock' EXIT
cw_read_state

if [ "$total" -gt 0 ]; then
  tmux rename-window -t "$WINDOW_ID" "■ ${completed}/${active}${label:+ $label}" 2>/dev/null || true
  if command -v osascript >/dev/null 2>&1; then
    # Pipe AppleScript on stdin with body/title as env vars so user-controlled
    # text cannot inject string literals or backslashes.
    _body="${label:-$(cw_workspace)} — ${completed}/${active} tasks"
    CLAUDE_TMUX_BODY="$_body" CLAUDE_TMUX_TITLE="Claude finished" \
      osascript <<'APPLESCRIPT' 2>/dev/null || true
on run
  set theBody to system attribute "CLAUDE_TMUX_BODY"
  set theTitle to system attribute "CLAUDE_TMUX_TITLE"
  display notification theBody with title theTitle
end run
APPLESCRIPT
  fi
fi
# No tasks: leave current title as-is

# Append to activity log when tasks ran
if [ "$total" -gt 0 ]; then
  _log="$(cw_state_dir)/activity.log"
  mkdir -p "$(dirname "$_log")"
  printf '%s\t%s\t%s\t%s/%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "${label:-(unlabeled)}" \
    "$(cw_workspace)" \
    "$completed" \
    "$active" >> "$_log" 2>/dev/null || true

  # Rotate when over cap (default 1 MiB). Keeps one .1 backup, oldest discarded.
  _cap="${CLAUDE_TMUX_LOG_MAX_BYTES:-1048576}"
  if [ -f "$_log" ]; then
    _sz=$(wc -c < "$_log" 2>/dev/null | tr -d ' ')
    if [ -n "$_sz" ] && [ "$_sz" -gt "$_cap" ]; then
      mv -f "$_log" "${_log}.1" 2>/dev/null || true
    fi
  fi
fi

# Clear task state; keep .cwd for the session picker; write .stopped for next boot
rm -f "${BASE}.total" "${BASE}.completed" "${BASE}.deleted" "${BASE}.label"
printf '1' > "${BASE}.stopped"

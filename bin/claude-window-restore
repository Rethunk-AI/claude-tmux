#!/bin/bash
# Claude Code PostToolUse hook — restores correct title after any tool
# Clears transient states like '?' and '!' back to the real progress state

set -euo pipefail
trap 'exit 0' ERR

source "${BASH_SOURCE[0]%/*}/claude-window-lib"
cw_init

if [ "$total" -eq 0 ]; then
  tmux rename-window -t "$WINDOW_ID" "○ $(cw_workspace)" 2>/dev/null || true
  exit 0
fi

tmux rename-window -t "$WINDOW_ID" "$(cw_title)" 2>/dev/null || true

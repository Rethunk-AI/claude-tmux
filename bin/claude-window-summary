#!/bin/bash
# claude-window-summary — fzf picker for all active and recently stopped Claude sessions

set -euo pipefail

source "${BASH_SOURCE[0]%/*}/claude-window-lib"
BASE_DIR="$(cw_state_dir)"

# Build maps: session+window key → tmux target and window name
# Key formula must match cw_resolve_window: s${session_id_digits}_w${window_id_digits}
declare -A WIN_TARGET WIN_NAME
# Tab-delimited so session / window names containing spaces parse cleanly.
while IFS=$'\t' read -r wid sid sess wname; do
  san="s${sid//[^0-9]/}_w${wid//[^0-9]/}"
  WIN_TARGET["$san"]="${sess}:${wid}"
  WIN_NAME["$san"]="$wname"
done < <(tmux list-windows -a -F $'#{window_id}\t#{session_id}\t#{session_name}\t#{window_name}' 2>/dev/null)

lines=()
for f in "$BASE_DIR"/claude-window-*.cwd; do
  [ -f "$f" ] || continue
  key="${f%.cwd}"
  key="${key##*/claude-window-}"
  target="${WIN_TARGET[$key]:-}"

  # Window no longer exists — clean up orphaned state files and skip
  if [ -z "$target" ]; then
    cw_remove_window_state "$BASE_DIR/claude-window-${key}"
    continue
  fi

  # GC stopped sentinels older than CLAUDE_TMUX_STOPPED_MAX_DAYS (default 30).
  # A window can stay open long after Claude stops; without this sweep the
  # picker would keep surfacing months-old `■` entries.
  stopfile="$BASE_DIR/claude-window-${key}.stopped"
  if [ -f "$stopfile" ] && [ ! -f "$BASE_DIR/claude-window-${key}.total" ]; then
    max_days="${CLAUDE_TMUX_STOPPED_MAX_DAYS:-30}"
    if [ -n "$(find "$stopfile" -mtime +"$max_days" -print 2>/dev/null)" ]; then
      cw_remove_window_state "$BASE_DIR/claude-window-${key}"
      continue
    fi
  fi

  wname="${WIN_NAME[$key]:-}"
  cwd=$(cat "$f" 2>/dev/null || echo "")
  short_path="${cwd/#$HOME/~}"

  lines+=("${target}	$(printf '%-36s  %s' "$wname" "$short_path")")
done

if [ "${#lines[@]}" -eq 0 ]; then
  printf '\n  No active Claude sessions.\n\n'
  # CI/smoke and other non-interactive callers have no TTY; skip blocking read.
  if [ -t 0 ]; then
    printf '  Press any key to close...'
    read -r -n1
  fi
  exit 0
fi

selected=$(printf '%s\n' "${lines[@]}" \
  | fzf --reverse --no-sort --delimiter=$'\t' --with-nth=2 \
      --header='WINDOW TITLE                          PATH                       — Enter to switch' \
      --prompt='  ')

[ -z "$selected" ] && exit 0

target=$(printf '%s' "$selected" | cut -f1)
tmux switch-client -t "$target" 2>/dev/null || true
